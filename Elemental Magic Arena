local function snapshot()
    local t = {}
    for k, o in pairs(Options) do
        if k ~= "Language" then
            local v = o.Value
            if typeof(v) == "Color3" then v = v:ToHex() end
            if typeof(v) == "EnumItem" then v = tostring(v) end
            t[k] = v
        end
    end
    local ok, s = pcall(HttpService.JSONEncode, HttpService, t)
    return ok and s or ""
end

task.spawn(function()
    local last = snapshot()
    while not stopped() do
        task.wait(2)
        local now = snapshot()
        if now ~= last and not stopped() then
            last = now
            pcall(function() SaveManager:Save(AUTO) end)
        end
    end
end)

