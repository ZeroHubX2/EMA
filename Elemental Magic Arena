local ToolSlot = setmetatable({}, { __mode = "k" })

local function slotOf(tool)
    if ToolSlot[tool] then return ToolSlot[tool] end
    if onCooldown(tool) then return nil end
    local i = ToolIndex[tool.Name] or ToolIndex[(tool.Name:gsub("%s*[%(%[][^%)%]]*[%)%]]%s*$", ""))]
    if i then ToolSlot[tool] = i end
    return i
end

local function slotAllowed(tool)
    local slot = slotOf(tool)
    if not slot then return true end
    return Options.SkillSlots.Value[tostring(slot)] == true
end

task.spawn(function()
    while not stopped() do
        task.wait(0.2)
        for _, t in ipairs(getTools()) do slotOf(t) end
    end
end)

local function keySkill(tool, key, z)
    local h = humanoid()
    local c = char()
    local animator = h and h:FindFirstChildOfClass("Animator")
    local animate = c and c:FindFirstChild("Animate")
    local tracks = {}
    local con
    if animator then
        con = animator.AnimationPlayed:Connect(function(tr)
            local anim = tr.Animation
            if tr.Looped then return end
            if animate and anim and anim:IsDescendantOf(animate) then return end
            table.insert(tracks, tr)
        end)
    end
    local nameBefore = tool.Name
    pressKey(key)
    local t0 = os.clock()
    while os.clock() - t0 < 0.35 and #tracks == 0 and tool.Name == nameBefore do
        task.wait(0.03)
    end
    if #tracks > 0 or tool.Name ~= nameBefore then
        local t1 = os.clock()
        while os.clock() - t1 < Options.KeyPause.Value do
            local playing = false
            for _, tr in ipairs(tracks) do
                if tr.IsPlaying then playing = true break end
            end
            if not playing and os.clock() - t1 > 0.2 then break end
            if not inArena() or not Options.AutoSkill.Value then break end
            if z and zombieAlive(z) then aimAt(z) end
            task.wait(0.05)
        end
    end
    if con then con:Disconnect() end
end

local skillStep

task.spawn(function()
    while not stopped() do
        task.wait(0.1)
        local ok, err = pcall(function() skillStep() end)
        if not ok then
            AimTarget = nil
            CastUntil = 0
            warn("[EMA] skill loop: " .. tostring(err))
            task.wait(1)
        end
    end
end)

skillStep = function()
        if Options.AutoSkill.Value and inArena() then
            local z = nearestZombie(Options.TargetRange.Value)
            if not z then
                AimTarget = nil
                if not Options.AutoFarm.Value then setStatus(L.Waiting) end
            else
                setStatus(L.Fighting .. z.Name)
                for _, tool in ipairs(getTools()) do
                    if not Options.AutoSkill.Value or stopped() then break end
                    if not zombieAlive(z) then
                        z = nearestZombie(Options.TargetRange.Value)
                        if not z then break end
                    end
                    if not onCooldown(tool) and slotAllowed(tool) then
                        local h = humanoid()
                        if h and tool.Parent ~= char() then
                            pcall(function() h:EquipTool(tool) end)
                            task.wait(0.15)
                        end
                        aimAt(z)
                        local nameBefore = tool.Name
                        CastUntil = os.clock() + Options.CastTime.Value
                        local keys = Options.SkillKeys.Value
                        for name, on in pairs(keys) do
                            if on and KeyMap[name] and tool.Parent == char() and inArena() then
                                aimAt(z)
                                keySkill(tool, KeyMap[name], z)
                            end
                        end
                        nameBefore = tool.Name
                        if keys.Click then
                            toolClick(tool, Options.ClickHold.Value, z)
                        end
                        local t0 = os.clock()
                        local lastClick = os.clock()
                        local fired = false
                        while os.clock() - t0 < Options.CastTime.Value do
                            if tool.Name ~= nameBefore or onCooldown(tool) then
                                fired = true
                                break
                            end
                            if not inArena() or not Options.AutoSkill.Value or tool.Parent ~= char() then break end
                            if zombieAlive(z) then aimAt(z) end
                            if keys.Click and Options.SpamClick.Value and os.clock() - lastClick >= Options.ClickRate.Value then
                                lastClick = os.clock()
                                toolClick(tool, math.min(Options.ClickHold.Value, Options.ClickRate.Value * 0.8), z)
                            end
                            task.wait(0.03)
                        end
                        CastUntil = 0
                        if fired then task.wait(0.3) end
                        local hh = humanoid()
                        if hh then pcall(function() hh:UnequipTools() end) end
                        task.wait(Options.SkillDelay.Value)
                    end
                end
                AimTarget = nil
            end
        else
            AimTarget = nil
        end
end

