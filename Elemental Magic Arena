            else
                opt:SetValue(v)
                closePicker()
            end
        end)
    end
    if search then
        search:GetPropertyChangedSignal("Text"):Connect(refresh)
    end
    refresh()
end

local function addPicker(section, id, cfg)
    local opt = {
        Type = "Dropdown",
        Title = cfg.Title,
        Values = cfg.Values or {},
        Multi = cfg.Multi == true,
        Callback = cfg.Callback,
        Changed = nil,
    }
    local btn
    local function display()
        if opt.Multi then
            local parts = {}
            for _, v in ipairs(opt.Values) do
                if opt.Value[v] then table.insert(parts, v) end
            end
            return #parts > 0 and table.concat(parts, ", ") or "-"
        end
        return opt.Value ~= nil and tostring(opt.Value) or "-"
    end
    local baseDesc = cfg.Description
    local function descText()
        local cur = "> " .. display()
        return baseDesc and (baseDesc .. "\n" .. cur) or cur
    end
    function opt:SetValue(v)
        if self.Multi then
            local t = {}
            if type(v) == "table" then
                for k, on in pairs(v) do
                    if type(k) == "number" then
                        t[on] = true
                    elseif on then
                        t[k] = true
                    end
                end
            end
            self.Value = t
        else
            if type(v) == "number" then v = self.Values[v] end
            self.Value = v
        end
        if btn then pcall(function() btn:SetDesc(descText()) end) end
        if self.Callback then task.spawn(pcall, self.Callback, self.Value) end
        if self.Changed then task.spawn(pcall, self.Changed, self.Value) end
    end
    function opt:OnChanged(fn)
        self.Changed = fn
        fn(self.Value)
    end
    function opt:SetValues(list)
        self.Values = list
        if not self.Multi and not table.find(list, self.Value) then
            self.Value = list[1]
        end
        if btn then pcall(function() btn:SetDesc(descText()) end) end
    end
    function opt:Destroy()
        Options[id] = nil
    end
    if opt.Multi then
        opt.Value = {}
        if type(cfg.Default) == "table" then
            for _, v in ipairs(cfg.Default) do opt.Value[v] = true end
        end
    else
        local d = cfg.Default
