local SafePos = nil

local function mapCenter()
    local map = workspace:FindFirstChild("Zombie Map")
    if not map then return nil end
    local floor, area = nil, 0
    for _, d in ipairs(map:GetDescendants()) do
        if d:IsA("BasePart") and d.CanCollide then
            local a = d.Size.X * d.Size.Z
            if a > area then floor, area = d, a end
        end
    end
    if not floor then return nil end
    local top = floor.Position.Y + floor.Size.Y / 2
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = { char() }
    for _, z in ipairs(getEnemies()) do table.insert(ignore, z) end
    params.FilterDescendantsInstances = ignore
    local origin = Vector3.new(floor.Position.X, top + 200, floor.Position.Z)
    local hit = workspace:Raycast(origin, Vector3.new(0, -260, 0), params)
    if hit then return hit.Position + Vector3.new(0, 4, 0) end
    return Vector3.new(floor.Position.X, top + 4, floor.Position.Z)
end

