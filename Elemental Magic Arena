local function findStands()
    local labels = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("TextLabel") then
            local name = ElementLower[trim(d.Text):lower()]
            local bb = name and d:FindFirstAncestorWhichIsA("BillboardGui")
            if bb then
                local ad = bb.Adornee or bb.Parent
                local pos
                if ad and ad:IsA("BasePart") then pos = ad.Position
                elseif ad and ad:IsA("Attachment") then pos = ad.WorldPosition
                elseif ad and ad:IsA("Model") then pos = ad:GetPivot().Position end
                if pos and pos.Y > -60 then table.insert(labels, { name = name, pos = pos }) end
            end
        end
    end
    local stands = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and d.Position.Y > -60 and d:FindFirstChildOfClass("TouchTransmitter") then
            local n = d.Name:lower()
            local isStand = (n:find("tp$") or n:find("teleport")) and not d:FindFirstAncestor("Redeem Codes PAD")
            if isStand then
                local best, bestD = nil, 40
                for _, l in ipairs(labels) do
                    local dist = (l.pos - d.Position).Magnitude
                    if dist < bestD then best, bestD = l.name, dist end
                end
                if best and not stands[best] then stands[best] = d end
            end
        end
    end
    return stands
end

