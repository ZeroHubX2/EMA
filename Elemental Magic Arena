local function setWindowSize(w, h)
    local vp = workspace.CurrentCamera.ViewportSize
    w = math.clamp(math.floor(w), 300, math.max(300, vp.X - 10))
    h = math.clamp(math.floor(h), 200, math.max(200, vp.Y - 10))
    pcall(function()
        Window.Size = UDim2.fromOffset(w, h)
        Window.Maximize(true, true, true)
        Window.Maximize(false, true, true)
    end)
end

