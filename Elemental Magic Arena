    if not dragInput then return end
    if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        if delta.Magnitude > 6 then moved = true end
        if moved then
            ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
end))

track(UIS.InputEnded:Connect(function(input)
    if dragInput and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
        local wasMoved = moved
        dragInput = nil
        if not wasMoved then
            pcall(function() Window:Minimize() end)
        end
    end
end))

local cleaned = false
local function cleanup()
    if cleaned then return end
    cleaned = true
    pcall(function() ToggleGui:Destroy() end)
    pcall(function() PickerGui:Destroy() end)
    pcall(unfreezeScroll)
    AimTarget = nil
    CastUntil = 0
    pcall(setNoclip, false)
    pcall(function() LP.DevCameraOcclusionMode = OrigOcclusion end)
    pcall(function()
        local h = humanoid()
        if h and CamOverride then workspace.CurrentCamera.CameraSubject = h end
        CamOverride = false
    end)
    FarmTarget = nil
    for _, c in ipairs(Conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(Conns)
    for zr, o in pairs(Original) do
        pcall(function()
            zr.Size, zr.Transparency, zr.CanCollide = o[1], o[2], o[3]
        end)
        Original[zr] = nil
    end
    if Env.EMA_Session == Session then
        Env.EMA_Session = nil
        Env.EMA_Unload = nil
    end
end

Env.EMA_Unload = function()
    cleanup()
    pcall(function() Fluent:Destroy() end)
end

task.spawn(function()
    while not stopped() do
        task.wait(0.5)
    end
    cleanup()
    if not Fluent.Unloaded then
