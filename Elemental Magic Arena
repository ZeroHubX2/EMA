            end
            local top = f.AbsolutePosition.Y
            if top < 10 then
                f.Position = UDim2.fromOffset(f.Position.X.Offset, f.Position.Y.Offset + (10 - top))
            elseif top + f.AbsoluteSize.Y > vpY - 10 then
                f.Position = UDim2.fromOffset(f.Position.X.Offset, f.Position.Y.Offset - (top + f.AbsoluteSize.Y - (vpY - 10)))
            end
        end
    end
end))

local Drag = { slider = nil, list = nil, frozen = {} }
local HookedRails = setmetatable({}, { __mode = "k" })

local function freezeScroll(inst)
    local p = inst.Parent
    while p do
        if p:IsA("ScrollingFrame") and p.ScrollingEnabled then
            p.ScrollingEnabled = false
            table.insert(Drag.frozen, p)
        end
        p = p.Parent
    end
end

local function unfreezeScroll()
    for _, sf in ipairs(Drag.frozen) do
        pcall(function() sf.ScrollingEnabled = true end)
    end
    table.clear(Drag.frozen)
end

local function applySlider(x)
    local s = Drag.slider
    if not s then return end
    local o = Options[s.id]
    local rail = s.rail
    if not o or not rail.Parent or rail.AbsoluteSize.X <= 0 then return end
    local frac = math.clamp((x - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
    o:SetValue(o.Min + (o.Max - o.Min) * frac)
end

local function hookRails()
    local gui = Fluent.GUI
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("UISizeConstraint") and d.MaxSize.X == 150 and d.Parent and d.Parent:IsA("Frame") and not HookedRails[d.Parent] then
            local rail = d.Parent
            local elem = rail.Parent
            local id
            if elem then
                for _, t in ipairs(elem:GetDescendants()) do
                    if t:IsA("TextLabel") and SliderTitles[t.Text] then
                        id = SliderTitles[t.Text]
                        break
                    end
                end
            end
            if id then
                HookedRails[rail] = id
                rail.Active = true
                track(rail.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Drag.slider = { rail = rail, id = id }
                        freezeScroll(rail)
                        applySlider(input.Position.X)
                    end
                end))
            end
        end
    end
end

local function openLists()
    local lists = {}
    local gui = Fluent.GUI
    if not gui then return lists end
    for _, f in ipairs(gui:GetChildren()) do
        local sc = f:IsA("Frame") and f.Visible and f:FindFirstChildOfClass("UISizeConstraint")
        if sc and sc.MinSize.X == 170 then
            local sf = f:FindFirstChildWhichIsA("ScrollingFrame", true)
            if sf then table.insert(lists, sf) end
        end
    end
    return lists
end

track(UIS.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position
    for _, sf in ipairs(openLists()) do
        local ap, as = sf.AbsolutePosition, sf.AbsoluteSize
        if pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
            Drag.list = { sf = sf, y = pos.Y, canvas = sf.CanvasPosition.Y }
            break
        end
    end
end))

track(UIS.InputChanged:Connect(function(input)
    local t = input.UserInputType
    if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseMovement then return end
    if Drag.slider then
        applySlider(input.Position.X)
    end
    if Drag.list and t == Enum.UserInputType.Touch then
        local l = Drag.list
        local sf = l.sf
        if not sf.Parent then Drag.list = nil return end
        local maxY = math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y)
        local y = math.clamp(l.canvas - (input.Position.Y - l.y), 0, maxY)
        sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, y)
    end
end))

track(UIS.InputEnded:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
        if Drag.slider then
            Drag.slider = nil
            unfreezeScroll()
        end
        Drag.list = nil
    end
end))

task.spawn(function()
    while not stopped() do
        pcall(hookRails)
        task.wait(2)
    end
end)

