    end
    local zr = FarmTarget.HumanoidRootPart
    if Options.FarmPos.Value == L.PosAbove or Options.FarmPos.Value == L.PosBelow then
        local offset = Options.FarmPos.Value == L.PosBelow and -Options.BelowDepth.Value or Options.AboveHeight.Value
