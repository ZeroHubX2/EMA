local function aimAt(z)
    local r = root()
    if not r or not z then return end
    local zr = z.HumanoidRootPart
    local above = Options.AutoFarm.Value and (Options.FarmPos.Value == L.PosAbove or Options.FarmPos.Value == L.PosBelow)
    if above and Options.FaceDown.Value then
        r.CFrame = CFrame.lookAt(r.Position, zr.Position, zr.CFrame.LookVector)
    elseif not above or (r.Position - zr.Position).Magnitude > 0.5 then
        local flat = Vector3.new(zr.Position.X, r.Position.Y, zr.Position.Z)
        if (flat - r.Position).Magnitude > 0.5 then
            r.CFrame = CFrame.lookAt(r.Position, flat)
