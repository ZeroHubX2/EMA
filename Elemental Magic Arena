local function aimLive()
    return AimTarget ~= nil and AimTarget.Parent ~= nil
end

pcall(function()
    local prev
    prev = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if not checkcaller() then
            local method = getnamecallmethod()
            if method == "Kick" and self == LP then
                return nil
            end
            if self == Cam and AimTarget and (method == "ViewportPointToRay" or method == "ScreenPointToRay") then
                local spoof = aimLive() and fromSkill()
                setnamecallmethod(method)
                local ray = prev(self, ...)
                if spoof and ray then
                    return Ray.new(ray.Origin, (AimTarget.Position - ray.Origin).Unit)
                end
                return ray
            end
        end
        return prev(self, ...)
    end))
end)

pcall(function()
    local prevIndex
    prevIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        local watched = (self == Mouse and (key == "Hit" or key == "Target" or key == "UnitRay")) or (self == Cam and key == "CFrame")
        if watched and AimTarget and not checkcaller() and aimLive() then
            if self == Mouse and fromSkill() then
                if key == "Hit" then
                    return CFrame.new(AimTarget.Position)
                elseif key == "Target" then
                    return AimTarget
                else
                    local ray = prevIndex(self, key)
                    return Ray.new(ray.Origin, (AimTarget.Position - ray.Origin).Unit)
                end
            elseif self == Cam and os.clock() < CastUntil and fromSkill() then
                local real = prevIndex(self, key)
                return CFrame.lookAt(real.Position, AimTarget.Position)
            end
        end
        return prevIndex(self, key)
    end))
end)

pcall(function()
    local prevNew
    prevNew = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if self == Cam and key == "CFrame" and AimTarget and not checkcaller() and fromSkill() then
