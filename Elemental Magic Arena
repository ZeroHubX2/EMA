local function mobileTap(tool, part)
    local st = tapTables()
    if not st or not part or not part.Parent then return false end
    local entry = st.tools[tool]
    local cam = workspace.CurrentCamera
    local pos = part.Position
    local dir = pos - cam.CFrame.Position
    if dir.Magnitude < 0.01 then dir = Vector3.new(0, -1, 0) end
    local sp = cam:WorldToViewportPoint(pos)
    st.last.cf = CFrame.lookAt(pos, pos + dir.Unit)
    st.last.target = part
    st.last.screen = Vector2.new(sp.X, sp.Y)
    for _, fn in ipairs(table.clone(st.any)) do
        task.spawn(pcall, fn, pos)
    end
    if entry then
        for _, fn in ipairs(entry.tapped) do
            task.spawn(pcall, fn, pos)
        end
        if entry.activate and tool.Enabled then
            pcall(function() tool:Activate() end)
        end
    else
        pcall(function() tool:Activate() end)
    end
    return true
end

